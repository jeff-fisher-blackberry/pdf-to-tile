<Window x:Class="pdf_to_Tiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:pdf_to_Tiles.ViewModels"
        xmlns:conv="clr-namespace:pdf_to_Tiles.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="850" Width="1350"
        MinHeight="600" MinWidth="950"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NotNullToVis" Invert="False" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" Invert="True" />
        <conv:EqualityToBooleanConverter x:Key="EqualConverter" />
        <conv:EqualityToVisibilityConverter x:Key="EqualToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BooleanInverterConverter x:Key="BoolInvert" />
        <conv:ColorToBrushConverter x:Key="ColorToBrush" />

        <!-- Checkerboard Transparency Tile Brush -->
        <DrawingBrush x:Key="CheckerboardBrush" Viewport="0,0,16,16" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#E5E7EB">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Tab RadioButton Style -->
        <Style x:Key="ModeTabRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#E5E7EB" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="tabBorder" Property="Background" Value="#FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Accent Action Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                </Trigger>
                <!-- Disabled: Neutral Grey Style (Not Blue) -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource ViewportBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clone Stamp Toggle Button Style: Rounded & Blue like Bevel, Light Blue When Active -->
        <Style x:Key="CloneStampToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <!-- Toggled ON / Active: Distinct Light Blue -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38BDF8" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7" />
                                <Setter Property="Foreground" Value="#082F49" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#7DD3FC" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7" />
                                <Setter Property="Foreground" Value="#082F49" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ViewportBackgroundBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter TargetName="border" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Alternating Tool Toggle Button Style: Blue when Checked, Grey when Unchecked -->
        <Style x:Key="AlternatingToolToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource ViewportBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ViewportBackgroundBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter TargetName="border" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Menu Bar & ToolBar Chrome -->
            <RowDefinition Height="Auto" />
            <!-- Mode Switcher Header Strip -->
            <RowDefinition Height="Auto" />
            <!-- Active Workspace Area -->
            <RowDefinition Height="*" />
            <!-- Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- TOP APP MENU BAR & TRADITIONAL TOOLBAR -->
        <!-- ========================================== -->
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <!-- Top Menu Bar -->
            <Menu Background="{DynamicResource PanelBackgroundBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="4,2"
                  FontSize="12">

                <!-- FILE MENU -->
                <MenuItem Header="_File">
                    <!-- Tab 1: PDF Viewer Section -->
                    <MenuItem Header="_Open PDF File..."
                              InputGestureText="Ctrl+O"
                              Command="{Binding OpenPdfCommand}"
                              IsEnabled="{Binding IsPdfViewerTabSelected}" />
                    <MenuItem Header="_Recent PDF Files..."
                              ItemsSource="{Binding RecentPdfs}"
                              IsEnabled="{Binding CanAccessRecentPdfs}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding DisplayName}" />
                                <Setter Property="ToolTip" Value="{Binding FilePath}" />
                                <Setter Property="Command" Value="{Binding DataContext.OpenRecentPdfCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                                <Setter Property="CommandParameter" Value="{Binding FilePath}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <MenuItem Header="_Close PDF"
                              InputGestureText="Ctrl+W"
                              Command="{Binding ClosePdfCommand}"
                              IsEnabled="{Binding CanClosePdf}" />
                    <Separator />

                    <!-- Tab 2: Tile Creator Section -->
                    <MenuItem Header="_Save Tile Page Image..."
                              InputGestureText="Ctrl+E"
                              Command="{Binding SaveTilePageImageCommand}"
                              IsEnabled="{Binding CanSaveTilePageImage}" />
                    <MenuItem Header="Open Tile _Page Image..."
                              InputGestureText="Ctrl+Shift+O"
                              Command="{Binding OpenImageForSlicingCommand}"
                              IsEnabled="{Binding IsTileCreatorTabSelected}" />
                    <MenuItem Header="Close _Tile Page Image"
                              InputGestureText="Ctrl+W"
                              Command="{Binding CloseTilePageImageCommand}"
                              IsEnabled="{Binding CanCloseTilePageImage}" />
                    <Separator />

                    <!-- Tab 3: Tile Editor Section -->
                    <MenuItem Header="Open _Tile Files..."
                              Command="{Binding OpenTileFilesCommand}"
                              IsEnabled="{Binding CanOpenTileFiles}" />
                    <MenuItem Header="Export _All Tiles"
                              InputGestureText="Ctrl+Shift+S"
                              Command="{Binding SaveAllTilesCommand}"
                              IsEnabled="{Binding CanSaveAllTiles}" />
                    <MenuItem Header="Export _Current Tile..."
                              InputGestureText="Ctrl+S"
                              Command="{Binding SaveCurrentTileCommand}"
                              IsEnabled="{Binding CanSaveCurrentTile}" />
                    <MenuItem Header="Close _Tiles"
                              InputGestureText="Ctrl+W"
                              Command="{Binding CloseTilesCommand}"
                              IsEnabled="{Binding CanCloseTiles}" />
                    <Separator />

                    <!-- Bottom Item -->
                    <MenuItem Header="E_xit"
                              InputGestureText="Alt+F4"
                              Command="{Binding ExitApplicationCommand}" />
                </MenuItem>

                <!-- EDIT MENU -->
                <MenuItem Header="_Edit" SubmenuOpened="EditMenu_SubmenuOpened">
                    <MenuItem Header="_Undo Tile Action"
                              InputGestureText="Ctrl+Z"
                              Command="{Binding UndoChitCommand}"
                              IsEnabled="{Binding CanUndoTileAction}" />
                    <MenuItem Header="_Redo Tile Action"
                              InputGestureText="Ctrl+Y"
                              Command="{Binding RedoChitCommand}"
                              IsEnabled="{Binding CanRedoTileAction}" />
                    <Separator />
                    <MenuItem Header="Cu_t Active Tile"
                              InputGestureText="Ctrl+X"
                              Command="{Binding CutChitCommand}"
                              IsEnabled="{Binding CanCutTile}" />
                    <MenuItem Header="_Copy Active Tile"
                              InputGestureText="Ctrl+C"
                              Command="{Binding CopyChitCommand}"
                              IsEnabled="{Binding CanCopyTile}" />
                    <MenuItem Header="_Paste Image..."
                              InputGestureText="Ctrl+V"
                              Command="{Binding PasteImageToTileCommand}" />
                    <MenuItem Header="Paste Image into _New Tile..."
                              InputGestureText="Ctrl+Shift+V"
                              Command="{Binding PasteImageToNewTileCommand}" />
                    <Separator />
                    <MenuItem Header="_Delete Current Tile..."
                              InputGestureText="Del"
                              Command="{Binding DeleteCurrentTileCommand}"
                              IsEnabled="{Binding CanDeleteCurrentTile}" />
                    <MenuItem Header="Delete _Selected Tiles..."
                              Command="{Binding DeleteSelectedTilesCommand}"
                              IsEnabled="{Binding CanDeleteSelectedTiles}" />
                    <Separator />
                    <MenuItem Header="Reset _Current Tile to Original"
                              Command="{Binding ResetSelectedChitCommand}"
                              IsEnabled="{Binding CanResetCurrentTile}" />
                    <MenuItem Header="Reset _All Tiles to Original"
                              Command="{Binding ResetAllChitsCommand}"
                              IsEnabled="{Binding CanResetAllTiles}" />
                </MenuItem>

                <!-- VIEW MENU -->
                <MenuItem Header="_View" Visibility="Collapsed">
                    <MenuItem Header="PDF _Viewer"
                              InputGestureText="Ctrl+1"
                              Command="{Binding SwitchTabCommand}"
                              CommandParameter="0" />
                    <MenuItem Header="_Tile Creator"
                              InputGestureText="Ctrl+2"
                              Command="{Binding SwitchTabCommand}"
                              CommandParameter="1" />
                    <MenuItem Header="_Tile Editor"
                              InputGestureText="Ctrl+3"
                              Command="{Binding SwitchTabCommand}"
                              CommandParameter="2" />
                    <Separator />
                    <MenuItem Header="Fit to _Width"
                              Command="{Binding FitWidthCommand}" />
                    <MenuItem Header="Fit to _View"
                              Command="{Binding FitViewCommand}" />
                    <MenuItem Header="_Actual Size (100%)"
                              Command="{Binding ActualSizeCommand}" />
                </MenuItem>

                <!-- HELP MENU -->
                <MenuItem Header="_Help">
                    <MenuItem Header="_Keyboard Shortcuts Reference..."
                              InputGestureText="F1"
                              Command="{Binding ShowShortcutsCommand}" />
                    <Separator />
                    <MenuItem Header="_About PDF to Tiles..."
                              Command="{Binding ShowAboutCommand}" />
                </MenuItem>
            </Menu>

            <!-- Traditional Desktop Toolbar (Hidden across all tabs via Visibility="Collapsed") -->
            <Border Visibility="Collapsed"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource ToolbarBackgroundBrush}">
                <ToolBarTray Background="Transparent"
                             IsLocked="True">
                    <ToolBar Background="Transparent"
                             Height="34"
                             ToolBarTray.IsLocked="True">

                    <!-- FILE GROUP -->
                    <Button Command="{Binding OpenPdfCommand}"
                            ToolTip="Open PDF Document (Ctrl+O)"
                            Width="30" Height="28"
                            Margin="2,1"
                            Padding="0">
                        <TextBlock Text="📄" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Command="{Binding OpenImageForSlicingCommand}"
                            ToolTip="Open Counter Sheet Image (Ctrl+Shift+O)"
                            Width="30" Height="28"
                            Margin="2,1"
                            Padding="0">
                        <TextBlock Text="🖼" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Command="{Binding ExportAllEditedChitsCommand}"
                            IsEnabled="{Binding HasChitsLoaded}"
                            ToolTip="Export All 20 Tiles to PNG (Ctrl+Shift+S)"
                            Width="30" Height="28"
                            Margin="2,1"
                            Padding="0">
                        <TextBlock Text="💾" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Separator Margin="4,3" />

                    <!-- EDIT / CLIPBOARD GROUP -->
                    <Button Command="{Binding UndoChitCommand}"
                            IsEnabled="{Binding CanUndoChit}"
                            ToolTip="Undo Tile Action (Ctrl+Z)"
                            Width="30" Height="28"
                            Margin="2,1"
                            Padding="0">
                        <TextBlock Text="↩" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Command="{Binding RedoChitCommand}"
                            IsEnabled="{Binding CanRedoChit}"
                            ToolTip="Redo Tile Action (Ctrl+Y)"
                            Width="30" Height="28"
                            Margin="2,1"
                            Padding="0">
                        <TextBlock Text="↪" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Command="{Binding CutChitCommand}"
                            IsEnabled="{Binding HasSelectedChit}"
                            ToolTip="Cut Active Tile (Ctrl+X)"
                            Width="30" Height="28"
                            Margin="2,1"
                            Padding="0">
                        <TextBlock Text="✂" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Command="{Binding CopyChitCommand}"
                            IsEnabled="{Binding HasSelectedChit}"
                            ToolTip="Copy Active Tile (Ctrl+C)"
                            Width="30" Height="28"
                            Margin="2,1"
                            Padding="0">
                        <TextBlock Text="📋" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Command="{Binding PasteChitCommand}"
                            IsEnabled="{Binding HasSelectedChit}"
                            ToolTip="Paste Image to Tile (Ctrl+V)"
                            Width="30" Height="28"
                            Margin="2,1"
                            Padding="0">
                        <TextBlock Text="📥" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Separator Margin="4,3" />

                    <!-- SLICER WORKFLOW GROUP -->
                    <Button Command="{Binding AutoDetectTiltCommand}"
                            IsEnabled="{Binding HasSlicerImage}"
                            ToolTip="Auto-Detect Counter Sheet Rotational Tilt"
                            Width="30" Height="28"
                            Margin="2,1"
                            Padding="0">
                        <TextBlock Text="📐" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Command="{Binding SendBandToChitEditorCommand}"
                            IsEnabled="{Binding HasSlicerImage}"
                            ToolTip="Send Active 2×10 Band to Tile Editor"
                            Width="30" Height="28"
                            Margin="2,1"
                            Padding="0">
                        <TextBlock Text="✂" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Separator Margin="4,3" />

                    <!-- VIEW / ZOOM GROUP -->
                    <Button Command="{Binding FitWidthCommand}"
                            ToolTip="Fit Viewport Width"
                            Width="30" Height="28"
                            Margin="2,1"
                            Padding="0">
                        <TextBlock Text="↔" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Command="{Binding FitViewCommand}"
                            ToolTip="Fit Entire Content into View"
                            Width="30" Height="28"
                            Margin="2,1"
                            Padding="0">
                        <TextBlock Text="⛶" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Command="{Binding ActualSizeCommand}"
                            ToolTip="Actual Size (100% Zoom)"
                            Width="34" Height="28"
                            Margin="2,1"
                            Padding="0">
                        <TextBlock Text="1:1" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                </ToolBar>
            </ToolBarTray>
        </Border>
    </StackPanel>

        <!-- ========================================== -->
        <!-- TOP APP HEADER & WORKSPACE MODE SWITCHER -->
        <!-- ========================================== -->
        <Border Grid.Row="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Workspace Switcher Tabs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <RadioButton Content="📄 PDF Viewer"
                                 Style="{StaticResource ModeTabRadioButton}"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualConverter}, ConverterParameter=0}" />

                    <RadioButton Content="📐 Tile Creator"
                                 Style="{StaticResource ModeTabRadioButton}"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualConverter}, ConverterParameter=1}" />

                    <RadioButton Content="✂ Tile Editor"
                                 Style="{StaticResource ModeTabRadioButton}"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualConverter}, ConverterParameter=2}" />
                </StackPanel>

                <!-- Quick File Status Label -->
                <TextBlock Grid.Column="1"
                           Text="{Binding LoadedFileName, TargetNullValue='No PDF Opened'}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12"
                           Margin="0,0,8,0" />
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- MAIN WORKSPACE CONTENT AREA -->
        <!-- ========================================== -->
        <Grid Grid.Row="2">

            <!-- ========================================== -->
            <!-- TAB 0: PDF VIEWER & HIGH-DPI CAPTURE -->
            <!-- ========================================== -->
            <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualToVis}, ConverterParameter=0}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- PDF Toolbar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource ToolbarBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left / Center PDF Toolbar Controls -->
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Hidden Open PDF button (PDFs opened via File menu) -->
                            <Button Content="📂 Open PDF..."
                                    Command="{Binding OpenPdfCommand}"
                                    Visibility="Collapsed"
                                    ToolTip="Open a PDF rulebook or counter sheet (non-locking)" />

                            <Rectangle Width="1" Height="22" Fill="{DynamicResource BorderBrush}" Margin="8,0" Visibility="Collapsed" />

                            <!-- Page Navigation -->
                            <Button Width="32"
                                    Padding="0"
                                    Command="{Binding FirstPageCommand}"
                                    ToolTip="First Page">
                                <Path Data="M 11,18 L 11,6 L 2.5,12 Z M 20,18 L 20,6 L 11.5,12 Z"
                                      Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform"
                                      Width="14" Height="10"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Button>

                            <Button Content="◀"
                                    Width="32"
                                    Padding="0"
                                    Command="{Binding PreviousPageCommand}"
                                    ToolTip="Previous page"
                                    Margin="2,0,0,0" />

                            <TextBlock Text="Page" Margin="8,0,4,0" VerticalAlignment="Center" />
                            <TextBox x:Name="PdfPageNumberTextBox"
                                     Text="{Binding CurrentPageNumber, UpdateSourceTrigger=LostFocus}"
                                     KeyDown="PdfPageNumberTextBox_KeyDown"
                                     Width="40"
                                     TextAlignment="Center"
                                     VerticalAlignment="Center"
                                     ToolTip="Enter page number and press Enter" />
                            <TextBlock Text="{Binding TotalPages, StringFormat=' of {0}'}" Margin="4,0,8,0" VerticalAlignment="Center" />

                            <Button Content="▶"
                                    Width="32"
                                    Padding="0"
                                    Command="{Binding NextPageCommand}"
                                    ToolTip="Next page" />

                            <Button Width="32"
                                    Padding="0"
                                    Command="{Binding LastPageCommand}"
                                    ToolTip="Last Page"
                                    Margin="2,0,0,0">
                                <Path Data="M 4,18 L 12.5,12 L 4,6 Z M 13,18 L 21.5,12 L 13,6 Z"
                                      Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform"
                                      Width="14" Height="10"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Button>

                            <Rectangle Width="1" Height="22" Fill="{DynamicResource BorderBrush}" Margin="8,0" />

                            <!-- Zoom Controls -->
                            <Button Content="Fit to Page"
                                    Command="{Binding FitToPageCommand}"
                                    ToolTip="Scale page to fit inside the visible viewport" />

                            <Button Content="Actual Size (100%)"
                                    Command="{Binding ActualSizeCommand}"
                                    ToolTip="Display page at 100% scale" />

                            <Button Content="-"
                                    Width="30"
                                    Command="{Binding ZoomOutCommand}"
                                    ToolTip="Zoom out (1%)" />

                            <Button Content="+"
                                    Width="30"
                                    Command="{Binding ZoomInCommand}"
                                    ToolTip="Zoom in (1%)" />

                            <TextBlock Text="Zoom:" Margin="8,0,2,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ZoomPercentageText}" FontWeight="Bold" Width="55" VerticalAlignment="Center" />

                            <Rectangle Width="1" Height="22" Fill="{DynamicResource BorderBrush}" Margin="8,0" />

                            <TextBlock Text="DPI:" Margin="6,0,2,0" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding AvailableDpis}"
                                      SelectedItem="{Binding SelectedDpi}"
                                      Width="70"
                                      VerticalAlignment="Center"
                                      ToolTip="Select capture DPI resolution" />

                            <TextBlock Text="Tag:" Margin="6,0,2,0" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding AvailableSideTags}"
                                      SelectedItem="{Binding SelectedSideTag}"
                                      Width="75"
                                      VerticalAlignment="Center"
                                      ToolTip="Label sheet side (Page, Front, Rear)">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="Page">
                                                            <Setter Property="Foreground" Value="#EF4444" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Rectangle Width="1" Height="22" Fill="{DynamicResource BorderBrush}" Margin="8,0" />

                            <Button Content="📸 Capture Page as PNG"
                                    Command="{Binding CapturePageCommand}"
                                    ToolTip="Save current page at high DPI directly to a lossless PNG file" />
                        </WrapPanel>

                        <!-- Far Right: Next Button (Right-Justified) -->
                        <Button Grid.Column="1"
                                Content="Next"
                                Command="{Binding SendPageToSlicerCommand}"
                                IsEnabled="{Binding CanSendPageToSlicer}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="16,6"
                                Margin="8,0,4,0"
                                VerticalAlignment="Center"
                                ToolTip="Render high-DPI page directly into the Deskew &amp; Grid Slicer workspace" />
                    </Grid>
                </Border>

                <!-- PDF Viewport -->
                <ScrollViewer x:Name="PdfScrollViewer"
                              Grid.Row="1"
                              Background="{DynamicResource ViewportBackgroundBrush}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              SizeChanged="PdfScrollViewer_SizeChanged">

                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <Border Background="#FFFFFF"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                SnapsToDevicePixels="True"
                                Visibility="{Binding CurrentPageImage, Converter={StaticResource NotNullToVis}}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.25" />
                            </Border.Effect>
                            <Image Source="{Binding CurrentPageImage}"
                                   Stretch="None"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   SnapsToDevicePixels="True">
                                <Image.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}" />
                                </Image.LayoutTransform>
                            </Image>
                        </Border>

                        <!-- Empty State -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding CurrentPageImage, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="📄" FontSize="64" HorizontalAlignment="Center" Opacity="0.4" />
                            <TextBlock Text="No PDF Loaded"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ========================================== -->
            <!-- TAB 1: DESKEW & GRID SLICER WORKSPACE -->
            <!-- ========================================== -->
            <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualToVis}, ConverterParameter=1}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Slicer Toolbar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource ToolbarBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left / Center Slicer Toolbar Buttons -->
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Hidden Open Image button (Images opened via File menu) -->
                            <Button Content="📂 Open Image..."
                                    Command="{Binding OpenImageForSlicingCommand}"
                                    Visibility="Collapsed"
                                    ToolTip="Open a counter sheet image file (PNG, JPG, TIFF, BMP)" />

                            <Rectangle Width="1" Height="22" Fill="{DynamicResource BorderBrush}" Margin="8,0" Visibility="Collapsed" />

                            <!-- View Toggles (Collapsed per user request) -->
                            <CheckBox Content="Grid Overlay"
                                      IsChecked="{Binding ShowGridOverlay}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"
                                      Visibility="Collapsed"
                                      ToolTip="Show or hide the counter matrix slicing grid overlay" />

                            <CheckBox Content="Alignment Crosshairs"
                                      IsChecked="{Binding ShowAlignmentGrid}"
                                      VerticalAlignment="Center"
                                      Margin="6,0"
                                      Visibility="Collapsed"
                                      ToolTip="Display fine reference crosshairs across the canvas to verify straightening" />

                            <Rectangle Width="1" Height="22" Fill="{DynamicResource BorderBrush}" Margin="8,0" Visibility="Collapsed" />

                            <!-- 90° Sheet Rotation Buttons -->
                            <Button Content="↶ -90°"
                                    Command="{Binding RotateLeft90Command}"
                                    IsEnabled="{Binding HasSlicerImage}"
                                    ToolTip="Rotate Left 90°"
                                    Margin="1,0"
                                    Padding="6,2" />
                            <Button Content="↷ +90°"
                                    Command="{Binding RotateRight90Command}"
                                    IsEnabled="{Binding HasSlicerImage}"
                                    ToolTip="Rotate Right 90°"
                                    Margin="1,0"
                                    Padding="6,2" />

                            <Rectangle Width="1" Height="22" Fill="{DynamicResource BorderBrush}" Margin="6,0" />

                            <!-- Fine-Rotation Degrees Buttons: Restored & Visible -->
                            <TextBlock Text="Angle:" Margin="0,0,2,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding DeskewAngleText}" FontWeight="Bold" Width="54" Margin="0,0,4,0" VerticalAlignment="Center" TextAlignment="Center" />
                            <Button Content="-0.1°" Width="52" Padding="4,2" Command="{Binding NudgeAngleNegativeCommand}" ToolTip="Nudge angle -0.1°" Margin="1,0" />
                            <Button Content="+0.1°" Width="52" Padding="4,2" Command="{Binding NudgeAnglePositiveCommand}" ToolTip="Nudge angle +0.1°" Margin="1,0" />
                            <Button Content="0.0°" Width="48" Padding="4,2" Command="{Binding ResetAngleCommand}" ToolTip="Reset tilt angle to 0.0°" Margin="1,0" />

                            <Rectangle Width="1" Height="22" Fill="{DynamicResource BorderBrush}" Margin="8,0" />

                            <!-- Zoom Controls -->
                            <Button Content="Fit to Width"
                                    Command="{Binding SlicerFitToWidthCommand}"
                                    ToolTip="Scale counter sheet to fit visible viewport width" />

                            <Button Content="Fit to View"
                                    Command="{Binding SlicerFitToPageCommand}"
                                    ToolTip="Scale counter sheet to fit inside the visible viewport" />

                            <Button Content="Actual Size (100%)"
                                    Command="{Binding SlicerActualSizeCommand}"
                                    ToolTip="Display counter sheet at 100% scale" />

                            <Button Content="-"
                                    Width="30"
                                    Command="{Binding SlicerZoomOutCommand}"
                                    ToolTip="Zoom out (1%)" />

                            <Button Content="+"
                                    Width="30"
                                    Command="{Binding SlicerZoomInCommand}"
                                    ToolTip="Zoom in (1%)" />

                            <TextBlock Text="Zoom:" Margin="8,0,2,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SlicerZoomPercentageText}" FontWeight="Bold" Width="55" VerticalAlignment="Center" />

                            <!-- Auto Detect Tilt & Angle Slider (Hidden via Visibility="Collapsed") -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button Content="📐 Auto-Detect Tilt"
                                        Command="{Binding AutoDetectTiltCommand}"
                                        ToolTip="Automatically detect scan tilt angle using Hough line transform" />
                                <Slider Minimum="-5.0" Maximum="5.0" Value="{Binding DeskewAngle}"
                                        Width="120"
                                        SmallChange="0.05" LargeChange="0.5"
                                        TickFrequency="1.0" IsSnapToTickEnabled="False"
                                        VerticalAlignment="Center"
                                        ToolTip="Adjust deskew tilt angle (-5.0° to +5.0°)" />
                            </StackPanel>
                        </WrapPanel>

                        <!-- Far Right: Next Button (Right-Justified) -->
                        <Button Grid.Column="1"
                                Content="Next"
                                Command="{Binding SendBandToChitEditorCommand}"
                                IsEnabled="{Binding HasSlicerImage}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="16,6"
                                Margin="8,0,4,0"
                                VerticalAlignment="Center"
                                ToolTip="Slice active 2×10 band directly into memory and open in Tile Editor (Tab 3)" />
                    </Grid>
                </Border>

                <!-- Slicer Main Content Area: Left Settings Sidebar + Right Viewport -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Left Settings Column (Fixed/Locked width to fit Double Width comfortably) -->
                        <ColumnDefinition Width="360" MinWidth="360" MaxWidth="360" />
                        <!-- Splitter (Hidden/Locked) -->
                        <ColumnDefinition Width="0" />
                        <!-- Viewport Column -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT SETTINGS SIDEBAR -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="14" Orientation="Vertical">

                                <!-- SEND 2×10 BAND TO CHIT EDITOR ACTION (Moved to Toolbar far right; hidden via Visibility="Collapsed") -->
                                <Border Visibility="Collapsed"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,12">
                                    <Button Content="🎨 Send 2×10 Band to Tile Editor"
                                            Command="{Binding SendBandToChitEditorCommand}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Padding="14,10"
                                            FontSize="13"
                                            HorizontalAlignment="Stretch"
                                            ToolTip="Slice active 2×10 band directly into memory and open in Tile Editor (Tab 3)" />
                                </Border>

                                <!-- ========================================== -->
                                <!-- BANDED MODE: ACTIVE BAND BOUNDS CARD -->
                                <!-- ========================================== -->
                                <Border Visibility="{Binding IsBandedMode, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Rows and Columns" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center" />

                                        <!-- Front / Back Horizontal Radios directly under Rows and Columns header -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                                            <RadioButton Content="Front"
                                                         GroupName="SheetSideGroup"
                                                         IsChecked="{Binding IsFrontSide, Mode=TwoWay}"
                                                         FontSize="11"
                                                         FontWeight="SemiBold"
                                                         Margin="0,0,16,0"
                                                         ToolTip="Front side: left-to-right tile navigation and creation" />
                                            <RadioButton Content="Rear"
                                                         GroupName="SheetSideGroup"
                                                         IsChecked="{Binding IsBackSide, Mode=TwoWay}"
                                                         FontSize="11"
                                                         FontWeight="SemiBold"
                                                         ToolTip="Rear side: right-to-left tile navigation and creation per row to align with front tiles" />
                                        </StackPanel>

                                        <!-- Numeric [Columns] x [Row] Inputs with Swatch Button, Set Button, and Double Width Checkbox -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                            <!-- Compact Square Swatch Button opening 3x3 Color Popup -->
                                            <Button x:Name="OverlayColorPickerButton"
                                                    Width="24"
                                                    Height="24"
                                                    Margin="0,0,6,0"
                                                    Padding="0"
                                                    Cursor="Hand"
                                                    Click="OverlayColorPickerButton_Click"
                                                    ToolTip="Choose overlay border and active-tile shading color">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1.5"
                                                                CornerRadius="3"
                                                                Background="{Binding SlicerOverlayColor, Converter={StaticResource ColorToBrush}}" />
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- 3x3 Color Palette Popup -->
                                            <Popup x:Name="OverlayColorPopup"
                                                   DataContext="{Binding}"
                                                   PlacementTarget="{Binding ElementName=OverlayColorPickerButton}"
                                                   Placement="Bottom"
                                                   StaysOpen="False"
                                                   AllowsTransparency="True">
                                                <Border Background="{DynamicResource ViewportBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="4"
                                                        Padding="4"
                                                        Margin="0,2,0,0">
                                                    <ItemsControl ItemsSource="{Binding AvailableOverlayColors}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Rows="3" Columns="3" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Width="22" Height="22" Margin="2"
                                                                        Padding="0"
                                                                        Cursor="Hand"
                                                                        Command="{Binding DataContext.SelectOverlayColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Click="OverlayColorSwatch_Click"
                                                                        ToolTip="{Binding Name}">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="border"
                                                                                    CornerRadius="3"
                                                                                    Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                                    BorderThickness="1">
                                                                                <Ellipse x:Name="indicator"
                                                                                         Width="6" Height="6"
                                                                                         HorizontalAlignment="Center"
                                                                                         VerticalAlignment="Center"
                                                                                         Fill="#000000"
                                                                                         Visibility="Collapsed" />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter TargetName="border" Property="BorderThickness" Value="2" />
                                                                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                                    <Setter TargetName="indicator" Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                                        <Condition Binding="{Binding Name}" Value="Black" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter TargetName="indicator" Property="Fill" Value="#FFFFFF" />
                                                                                </MultiDataTrigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </Popup>

                                            <TextBox Text="{Binding PendingBandBox1, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="BandDimensionTextBox_KeyDown"
                                                     Width="44"
                                                     Height="24"
                                                     TextAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     ToolTip="Columns / Rows (Press Enter or click Set to apply)" />
                                            <TextBlock Text=" x "
                                                       VerticalAlignment="Center"
                                                       Margin="4,0"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBox Text="{Binding PendingBandBox2, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="BandDimensionTextBox_KeyDown"
                                                     Width="44"
                                                     Height="24"
                                                     TextAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     ToolTip="Columns / Rows (Press Enter or click Set to apply)" />
                                            <Button Content="Set"
                                                    Command="{Binding SetBandDimensionsCommand}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Width="40"
                                                    Height="24"
                                                    Margin="6,0,8,0"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Apply the configured Columns and Row dimensions to the band and grid" />

                                            <!-- Double Width Checkbox -->
                                            <CheckBox Content="Double Width"
                                                      IsChecked="{Binding IsDoubleWidthColumns}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,0,0"
                                                      ToolTip="Double width columns (~2x) for wide counters (e.g. 5 columns instead of 10)" />
                                        </StackPanel>

                                        <!-- Corner crosshair pickers: Upper-Left & Lower-Right -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Content="Set upper-left"
                                                      IsChecked="{Binding IsSettingUpperLeftCorner, Mode=TwoWay}"
                                                      FontWeight="SemiBold"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center"
                                                      ToolTip="When checked, click the counter sheet to set the upper-left (X, Y) corner of the band" />
                                            <CheckBox Grid.Column="1" Content="Set lower-right"
                                                      IsChecked="{Binding IsSettingLowerRightCorner, Mode=TwoWay}"
                                                      FontWeight="SemiBold"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center"
                                                      ToolTip="When checked, click the counter sheet to set the lower-right (X, Y) corner of the band" />
                                        </Grid>

                                        <!-- Underlying divider fine-tuning controls preserved for commands and bindings -->
                                        <StackPanel Visibility="Collapsed">
                                            <RadioButton Content="Even 10 Cols"
                                                         IsChecked="{Binding IsFineTuningDividers, Converter={StaticResource BoolInvert}}"
                                                         Margin="0,0,12,0" />
                                            <RadioButton Content="Fine-Tune Dividers"
                                                         IsChecked="{Binding IsFineTuningDividers}" />
                                            <ComboBox ItemsSource="{Binding AvailableDividerNames}"
                                                      SelectedIndex="{Binding SelectedDividerIndex}" />
                                            <Button Content="Reset" Command="{Binding ResetDividersToEvenCommand}" />
                                        </StackPanel>

                                        <!-- Band Left (X) -->
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Left (X):" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <RepeatButton Grid.Column="1" Content="◀" Command="{Binding NudgeActiveBandLeftNegativeCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="250" Interval="35" Margin="0,0,3,0" ToolTip="Nudge left boundary left (-1 px)" />
                                            <TextBox Grid.Column="2" x:Name="BandLeftTextBox" Text="{Binding ActiveBandLeftText, UpdateSourceTrigger=LostFocus}"
                                                     KeyDown="BandLeftTextBox_KeyDown" LostFocus="BandLeftTextBox_LostFocus"
                                                     Height="22" TextAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="11" />
                                            <RepeatButton Grid.Column="3" Content="▶" Command="{Binding NudgeActiveBandLeftPositiveCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="250" Interval="35" Margin="3,0,0,0" ToolTip="Nudge left boundary right (+1 px)" />
                                            <TextBlock Grid.Column="4" Text="{Binding ActiveBandLeftPercentText}" TextAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" FontSize="11" />
                                        </Grid>

                                        <!-- Band Top (Y) -->
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Top (Y):" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <RepeatButton Grid.Column="1" Content="▲" Command="{Binding NudgeActiveBandTopUpCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="250" Interval="35" Margin="0,0,3,0" ToolTip="Nudge top boundary up (-1 px)" />
                                            <TextBox Grid.Column="2" x:Name="BandTopTextBox" Text="{Binding ActiveBandTopText, UpdateSourceTrigger=LostFocus}"
                                                     KeyDown="BandTopTextBox_KeyDown" LostFocus="BandTopTextBox_LostFocus"
                                                     Height="22" TextAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="11" />
                                            <RepeatButton Grid.Column="3" Content="▼" Command="{Binding NudgeActiveBandTopDownCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="250" Interval="35" Margin="3,0,0,0" ToolTip="Nudge top boundary down (+1 px)" />
                                            <TextBlock Grid.Column="4" Text="{Binding ActiveBandTopPercentText}" TextAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" FontSize="11" />
                                        </Grid>

                                        <!-- Band Width -->
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Width:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <RepeatButton Grid.Column="1" Content="◀" Command="{Binding NudgeActiveBandWidthLeftCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="250" Interval="35" Margin="0,0,3,0" ToolTip="Nudge right boundary left (-1 px)" />
                                            <TextBox Grid.Column="2" x:Name="BandWidthTextBox" Text="{Binding ActiveBandWidthText, UpdateSourceTrigger=LostFocus}"
                                                     KeyDown="BandWidthTextBox_KeyDown" LostFocus="BandWidthTextBox_LostFocus"
                                                     Height="22" TextAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="11" />
                                            <RepeatButton Grid.Column="3" Content="▶" Command="{Binding NudgeActiveBandWidthRightCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="250" Interval="35" Margin="3,0,0,0" ToolTip="Nudge right boundary right (+1 px)" />
                                            <TextBlock Grid.Column="4" Text="{Binding ActiveBandWidthPercentText}" TextAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" FontSize="11" />
                                        </Grid>

                                        <!-- Band Height -->
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Height:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <RepeatButton Grid.Column="1" Content="▲" Command="{Binding NudgeActiveBandHeightUpCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="250" Interval="35" Margin="0,0,3,0" ToolTip="Nudge bottom boundary up (-1 px)" />
                                            <TextBox Grid.Column="2" x:Name="BandHeightTextBox" Text="{Binding ActiveBandHeightText, UpdateSourceTrigger=LostFocus}"
                                                     KeyDown="BandHeightTextBox_KeyDown" LostFocus="BandHeightTextBox_LostFocus"
                                                     Height="22" TextAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="11" />
                                            <RepeatButton Grid.Column="3" Content="▼" Command="{Binding NudgeActiveBandHeightDownCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="250" Interval="35" Margin="3,0,0,0" ToolTip="Nudge bottom boundary down (+1 px)" />
                                            <TextBlock Grid.Column="4" Text="{Binding ActiveBandHeightPercentText}" TextAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" FontSize="11" />
                                        </Grid>

                                        <!-- Row Split -->
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Row Split:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <RepeatButton Grid.Column="1" Content="▲" Command="{Binding NudgeActiveBandRowSplitUpCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="250" Interval="35" Margin="0,0,3,0" ToolTip="Nudge row split line up (-1 px)" />
                                            <TextBox Grid.Column="2" x:Name="BandRowSplitTextBox" Text="{Binding ActiveBandRowSplitText, UpdateSourceTrigger=LostFocus}"
                                                     KeyDown="BandRowSplitTextBox_KeyDown" LostFocus="BandRowSplitTextBox_LostFocus"
                                                     Height="22" TextAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="11" />
                                            <RepeatButton Grid.Column="3" Content="▼" Command="{Binding NudgeActiveBandRowSplitDownCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="250" Interval="35" Margin="3,0,0,0" ToolTip="Nudge row split line down (+1 px)" />
                                            <TextBlock Grid.Column="4" Text="{Binding ActiveBandRowSplitPercentText}" TextAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" FontSize="11" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- SINGLE CHIT PREVIEW CARD -->
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,12">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="TILE PREVIEW" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center" />

                                        <!-- Banded mode Chit 1..20 cycling stepper & dropdown -->
                                        <Grid Margin="0,2,0,6" Width="200" Visibility="{Binding IsBandedMode, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Content="◀ Prev" Command="{Binding PreviousChitCommand}" Width="48" Padding="2,3" ToolTip="Previous Tile (1..20 with wrap-around)" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="Tile:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                <ComboBox ItemsSource="{Binding AvailableChitNumbers}" SelectedItem="{Binding PreviewChitNumber}" Width="52" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="Next ▶" Command="{Binding NextChitCommand}" Width="48" Padding="2,3" ToolTip="Next Tile (1..20 with wrap-around)" />
                                        </Grid>

                                        <TextBlock Text="{Binding PreviewCellText}"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" HorizontalAlignment="Center" />

                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                Width="140" Height="140"
                                                Background="#F9FAFB">
                                            <Image Source="{Binding ChitPreviewImage}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- PROFILE & MATRIX CARD (Hidden via Visibility="Collapsed") -->
                                <Border Visibility="Collapsed"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="SHEET PRESET &amp; MATRIX" Style="{StaticResource SectionHeaderStyle}" />

                                        <TextBlock Text="Preset Profile:" Margin="0,4,0,2" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <ComboBox ItemsSource="{Binding AvailableProfiles}"
                                                  SelectedItem="{Binding SelectedProfile}"
                                                  DisplayMemberPath="Name"
                                                  Margin="0,0,0,8" />

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Sheet Side:" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <ComboBox ItemsSource="{Binding SlicerAvailableSides}"
                                                          SelectedItem="{Binding SelectedSide}"
                                                          Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Prefix:" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBox Text="{Binding NamingPrefix, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Uniform Grid Rows/Cols (visible only in UniformGrid mode) -->
                                        <Grid Margin="0,0,0,4" Visibility="{Binding IsUniformGridMode, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Rows:" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBox Text="{Binding ProfileRows, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Columns:" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBox Text="{Binding ProfileColumns, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ========================================== -->
                                <!-- UNIFORM GRID MODE: GRID BOUNDS CARD (LEGACY) -->
                                <!-- ========================================== -->
                                <Border Visibility="{Binding IsUniformGridMode, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="GRID BOUNDING BOX (% OF SHEET)" Style="{StaticResource SectionHeaderStyle}" />

                                        <!-- Left (X) -->
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Left (X):" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <RepeatButton Grid.Column="1" Content="◀" Command="{Binding NudgeGridLeftNegativeCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="300" Interval="50" Margin="0,0,4,0" ToolTip="Nudge matrix left boundary left (-0.1%)" />
                                            <Slider Grid.Column="2" Minimum="0" Maximum="50" Value="{Binding GridLeftPercent}" SmallChange="0.1" LargeChange="1.0"
                                                    PreviewKeyDown="LeftSlider_PreviewKeyDown" VerticalAlignment="Center" />
                                            <RepeatButton Grid.Column="3" Content="▶" Command="{Binding NudgeGridLeftPositiveCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="300" Interval="50" Margin="4,0,4,0" ToolTip="Nudge matrix left boundary right (+0.1%)" />
                                            <TextBlock Grid.Column="4" Text="{Binding GridLeftPercent, StringFormat='{}{0:F1}%'}" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Top (Y) -->
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Top (Y):" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <RepeatButton Grid.Column="1" Content="▲" Command="{Binding NudgeGridTopUpCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="300" Interval="50" Margin="0,0,4,0" ToolTip="Nudge matrix top boundary up (-0.1%)" />
                                            <Slider Grid.Column="2" Minimum="0" Maximum="50" Value="{Binding GridTopPercent}" SmallChange="0.1" LargeChange="1.0"
                                                    PreviewKeyDown="TopSlider_PreviewKeyDown" VerticalAlignment="Center" />
                                            <RepeatButton Grid.Column="3" Content="▼" Command="{Binding NudgeGridTopDownCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="300" Interval="50" Margin="4,0,4,0" ToolTip="Nudge matrix top boundary down (+0.1%)" />
                                            <TextBlock Grid.Column="4" Text="{Binding GridTopPercent, StringFormat='{}{0:F1}%'}" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Width -->
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Width:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <RepeatButton Grid.Column="1" Content="◀" Command="{Binding NudgeGridWidthLeftCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="300" Interval="50" Margin="0,0,4,0" ToolTip="Nudge matrix right boundary left / shrink width (-0.1%)" />
                                            <Slider Grid.Column="2" Minimum="50" Maximum="100" Value="{Binding GridWidthPercent}" SmallChange="0.1" LargeChange="1.0"
                                                    PreviewKeyDown="WidthSlider_PreviewKeyDown" VerticalAlignment="Center" />
                                            <RepeatButton Grid.Column="3" Content="▶" Command="{Binding NudgeGridWidthRightCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="300" Interval="50" Margin="4,0,4,0" ToolTip="Nudge matrix right boundary right / expand width (+0.1%)" />
                                            <TextBlock Grid.Column="4" Text="{Binding GridWidthPercent, StringFormat='{}{0:F1}%'}" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Height -->
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Height:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <RepeatButton Grid.Column="1" Content="▲" Command="{Binding NudgeGridHeightUpCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="300" Interval="50" Margin="0,0,4,0" ToolTip="Nudge matrix bottom boundary up / shrink height (-0.1%)" />
                                            <Slider Grid.Column="2" Minimum="50" Maximum="100" Value="{Binding GridHeightPercent}" SmallChange="0.1" LargeChange="1.0"
                                                    PreviewKeyDown="HeightSlider_PreviewKeyDown" VerticalAlignment="Center" />
                                            <RepeatButton Grid.Column="3" Content="▼" Command="{Binding NudgeGridHeightDownCommand}"
                                                          Width="22" Height="22" Padding="0" Delay="300" Interval="50" Margin="4,0,4,0" ToolTip="Nudge matrix bottom boundary down / expand height (+0.1%)" />
                                            <TextBlock Grid.Column="4" Text="{Binding GridHeightPercent, StringFormat='{}{0:F1}%'}" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- BATCH SLICE ACTION CARD (Hidden via Visibility="Collapsed") -->
                                <Border Visibility="Collapsed"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12">
                                    <StackPanel>
                                        <!-- Banded Mode Action (Single 2x10 Section / 20 Chits) -->
                                        <StackPanel Visibility="{Binding IsBandedMode, Converter={StaticResource BoolToVis}}">
                                            <Button Content="✂️ Slice 2×10 Band to Disk..."
                                                    Command="{Binding SliceActiveBandCommand}"
                                                    Padding="14,8"
                                                    FontSize="12"
                                                    HorizontalAlignment="Stretch"
                                                    ToolTip="Slice configured 2×10 band into 20 PNG files on disk" />
                                        </StackPanel>

                                        <!-- Uniform Mode Action -->
                                        <StackPanel Visibility="{Binding IsUniformGridMode, Converter={StaticResource BoolToVis}}">
                                            <Button Content="✂️ Slice Grid to PNG Pieces..."
                                                    Command="{Binding SliceGridCommand}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Padding="14,10"
                                                    FontSize="14"
                                                    ToolTip="Slice configured grid into individual lossless PNG playing pieces" />
                                        </StackPanel>

                                        <!-- Slicing Progress Box -->
                                        <StackPanel Visibility="{Binding IsSlicing, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                            <ProgressBar Value="{Binding SliceProgressPercent}" Maximum="100" Height="14" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding SliceProgressText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                            <Button Content="Cancel Slicing"
                                                    Command="{Binding CancelSliceCommand}"
                                                    Margin="0,8,0,0"
                                                    Background="#EF4444"
                                                    Foreground="#FFFFFF"
                                                    BorderBrush="#DC2626" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Splitter (Hidden/Locked) -->
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" Visibility="Collapsed" IsEnabled="False" />

                    <!-- RIGHT VIEWPORT: DESKEWED SHEET & INTERACTIVE GRID OVERLAY -->
                    <ScrollViewer x:Name="SlicerScrollViewer"
                                  Grid.Column="2"
                                  Background="{DynamicResource ViewportBackgroundBrush}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  SizeChanged="SlicerScrollViewer_SizeChanged"
                                  PreviewMouseLeftButtonDown="SlicerScrollViewer_PreviewMouseLeftButtonDown">

                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                            <!-- Drop shadow border around rendered sheet -->
                            <Border Background="#FFFFFF"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    SnapsToDevicePixels="True"
                                    Visibility="{Binding SlicerImage, Converter={StaticResource NotNullToVis}}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.25" />
                                </Border.Effect>

                                <Grid>
                                    <Image x:Name="SlicerImageDisplay"
                                           Source="{Binding SlicerImage}"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True"
                                           SizeChanged="SlicerImageDisplay_SizeChanged" />

                                    <Canvas x:Name="SlicerGridCanvas"
                                            Width="{Binding ElementName=SlicerImageDisplay, Path=ActualWidth}"
                                            Height="{Binding ElementName=SlicerImageDisplay, Path=ActualHeight}"
                                            IsHitTestVisible="False"
                                            ClipToBounds="True" />
                                </Grid>

                                <Border.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding SlicerZoomScale}" ScaleY="{Binding SlicerZoomScale}" />
                                </Border.LayoutTransform>
                            </Border>

                            <!-- Empty State for Slicer -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding SlicerImage, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="📐" FontSize="64" HorizontalAlignment="Center" Opacity="0.4" />
                                <TextBlock Text="No Counter Sheet Loaded"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ========================================== -->
            <!-- TAB 2: CHIT EDITOR WORKSPACE -->
            <!-- ========================================== -->
            <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualToVis}, ConverterParameter=2}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Chit Editor Toolbar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource ToolbarBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left / Center Chit Editor Controls -->
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="◀ Prev Tile" Command="{Binding SelectPrevChitCommand}" ToolTip="Select previous tile in strip" />
                            <Button Content="Next Tile ▶" Command="{Binding SelectNextChitCommand}" ToolTip="Select next tile in strip" Margin="4,0,0,0" />

                            <Rectangle Width="1" Height="22" Fill="{DynamicResource BorderBrush}" Margin="8,0" />

                            <Button Content="↩" Command="{Binding UndoChitCommand}" ToolTip="Undo last action for selected tile (Ctrl+Z)" Width="30" Height="26" Padding="0" />
                            <Button Content="↪" Command="{Binding RedoChitCommand}" ToolTip="Redo last undone action (Ctrl+Y)" Width="30" Height="26" Padding="0" Margin="4,0,0,0" />

                            <Rectangle Width="1" Height="22" Fill="{DynamicResource BorderBrush}" Margin="8,0" />

                            <Button Content="✂" Command="{Binding CutChitCommand}" ToolTip="Cut selected tile to clipboard (Ctrl+X)" Width="30" Height="26" Padding="0" />
                            <Button Content="📋" Command="{Binding CopyChitCommand}" ToolTip="Copy selected tile to clipboard (Ctrl+C)" Width="30" Height="26" Padding="0" Margin="4,0,0,0" />
                            <Button Content="📥" Command="{Binding PasteChitCommand}" ToolTip="Paste image from clipboard into active tile (Ctrl+V)" Width="30" Height="26" Padding="0" Margin="4,0,0,0" />

                            <Rectangle Width="1" Height="22" Fill="{DynamicResource BorderBrush}" Margin="8,0" />

                            <!-- Working Chit Zoom Group -->
                            <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="-" Command="{Binding ChitEditorZoomOutCommand}" Width="24" Height="24" Padding="0" Margin="1,0" ToolTip="Zoom out 1% (-0.01)" />
                            <Button Content="+" Command="{Binding ChitEditorZoomInCommand}" Width="24" Height="24" Padding="0" Margin="1,0" ToolTip="Zoom in 1% (+0.01)" />
                            <TextBox x:Name="ChitEditorZoomTextBox"
                                     Text="{Binding ChitEditorZoomInputText, UpdateSourceTrigger=LostFocus}"
                                     Width="48" Height="24" Padding="2,1" Margin="3,0,1,0"
                                     FontSize="11" TextAlignment="Center"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     ToolTip="Enter zoom percentage (e.g. 100%, 250) and press Enter"
                                     KeyDown="ChitEditorZoomTextBox_KeyDown"
                                     LostFocus="ChitEditorZoomTextBox_LostFocus" />
                            <Button Content="100%"
                                    Command="{Binding ChitEditorZoomResetCommand}"
                                    Width="42" Height="24"
                                    Padding="0" Margin="3,0,0,0"
                                    FontSize="11" FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    ToolTip="Reset Zoom to 100%" />

                            <Rectangle Width="1" Height="22" Fill="{DynamicResource BorderBrush}" Margin="8,0" />

                            <Button Content="Reset Current"
                                    Command="{Binding ResetSelectedChitCommand}"
                                    Height="26"
                                    Padding="8,3"
                                    ToolTip="Revert active tile back to original slice" />
                            <Button Content="Reset All"
                                    Command="{Binding ResetAllChitsCommand}"
                                    Height="26"
                                    Padding="8,3"
                                    Margin="4,0,0,0"
                                    ToolTip="Revert all loaded tiles back to original slices" />
                        </WrapPanel>

                        <!-- Far Right: Right-Justified Export Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0">
                            <Button Content="Export Current"
                                    Command="{Binding ExportSelectedChitCommand}"
                                    Padding="12,6"
                                    ToolTip="Export currently selected tile as a lossless PNG file" />
                            <Button Content="Export All"
                                    Command="{Binding ExportAllEditedChitsCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Margin="6,0,0,0"
                                    Padding="14,6"
                                    ToolTip="Export all 20 tiles to destination folder" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main 3-Section Working Workspace: Fixed Left Controls Panel, Fluid Center Canvas, Resizable Right Strip -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Left Controls Panel: Locked fixed width (non-resizable) -->
                        <ColumnDefinition Width="400" MinWidth="400" MaxWidth="400" />
                        <!-- Center Working Canvas -->
                        <ColumnDefinition Width="*" MinWidth="400" />
                        <!-- Splitter for Right Tile Strip -->
                        <ColumnDefinition Width="4" />
                        <!-- Right Tile Strip -->
                        <ColumnDefinition Width="270" MinWidth="220" MaxWidth="400" />
                    </Grid.ColumnDefinitions>

                    <!-- COLUMN 0: LEFT CONTROLS PANEL -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                            <StackPanel>
                                <!-- Export All 20 Chits to PNG Button at Top of Left Panel (Hidden; handled on toolbar) -->
                                <Button Content="✂️ Export All 20 Tiles to PNG..."
                                        Command="{Binding ExportAllEditedChitsCommand}"
                                        Visibility="Collapsed"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Padding="12,8"
                                        FontSize="13"
                                        Margin="0,0,0,12"
                                        ToolTip="Save all 20 tiles to a destination folder" />

                                <!-- TILE TOOLS CARD (Modeled on GTL Text Editor) -->
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Tile tools" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" Margin="0" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Select All"
                                                        Command="{Binding SelectAllTilesCommand}"
                                                        Height="24"
                                                        Padding="8,2"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        ToolTip="Select and check all tiles in the strip" />
                                                <Button Content="Deselect All"
                                                        Command="{Binding DeselectAllTilesCommand}"
                                                        Height="24"
                                                        Padding="8,2"
                                                        Margin="4,0,0,0"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        ToolTip="Deselect and uncheck all tiles in the strip" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Subpanel 1: Dimensions & Resizing -->
                                        <Border Background="{DynamicResource ViewportBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,6"
                                                Margin="0,0,0,6">
                                            <StackPanel>
                                                <!-- Row 1: Dimensions (Width x Height) + Square Checkbox -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Dimensions Left -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBox Text="{Binding ChitEditorWidth, UpdateSourceTrigger=PropertyChanged}" Width="48" TextAlignment="Center" Padding="2,3" ToolTip="Width in pixels (also sets height when Square is checked)" />
                                                        <TextBlock Text="×" Margin="4,0" VerticalAlignment="Center" FontWeight="Bold" />
                                                        <TextBox Text="{Binding ChitEditorHeight, UpdateSourceTrigger=PropertyChanged}"
                                                                 IsEnabled="{Binding IsResizeSquare, Converter={StaticResource BoolInvert}}"
                                                                 Width="48" TextAlignment="Center" Padding="2,3"
                                                                 ToolTip="Height in pixels (disabled when Square is checked)" />
                                                    </StackPanel>

                                                    <!-- Square Checkbox Right -->
                                                    <CheckBox Grid.Column="2" Content="Square"
                                                              IsChecked="{Binding IsResizeSquare}"
                                                              FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                              ToolTip="Constrain target dimensions to min(Width, Height) square for Scale Image and Resize Image" />
                                                </Grid>

                                                <!-- Row 2: Equal-Width Scale Image and Resize Image Buttons -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="Scale Image" Command="{Binding ApplyScaleImageCommand}" Height="28" ToolTip="Resample image to exact Width × Height (shrinks if smaller, stretches if larger)" />
                                                    <Button Grid.Column="2" Content="Resize Image" Command="{Binding ApplyResizeImageCommand}" Height="28" ToolTip="Crop inwards or pad canvas to target Width × Height (preserves 1:1 pixel scale)" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Subpanel 2: Clone Stamp Tool (Paint.NET Style) -->
                                        <Border Background="{DynamicResource ViewportBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,6"
                                                Margin="0,0,0,6">
                                            <StackPanel>
                                                <!-- Mode Toggle Button (Shift+Click used for anchor) + Floating / Anchored Radios -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton Grid.Column="0"
                                                                  IsChecked="{Binding IsCloneStampActive}"
                                                                  Style="{StaticResource CloneStampToggleButtonStyle}"
                                                                  Content="Clone Stamp"
                                                                  HorizontalAlignment="Left"
                                                                  ToolTip="Toggle Paint.NET-style Clone Stamp tool (Shift+Click canvas to set source anchor)" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <RadioButton Content="Floating"
                                                                     GroupName="CloneStampMode"
                                                                     IsChecked="{Binding IsCloneModeFloating}"
                                                                     FontSize="11"
                                                                     FontWeight="SemiBold"
                                                                     Margin="0,0,6,0"
                                                                     ToolTip="Floating mode (default): source sampling moves relative to cursor as you drag" />
                                                        <RadioButton Content="Anchored"
                                                                     GroupName="CloneStampMode"
                                                                     IsChecked="{Binding IsCloneModeAnchored}"
                                                                     FontSize="11"
                                                                     FontWeight="SemiBold"
                                                                     ToolTip="Anchored mode: source area stays fixed at the chosen anchor point and stamps that exact patch" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Shape Selection (Circle / Square) + Size Stepper -->
                                                <Grid Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Shape Radios (Square default, Circle second) -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <RadioButton Content="■ Square"
                                                                     GroupName="CloneStampShape"
                                                                     IsChecked="{Binding IsCloneSquareShape}"
                                                                     FontSize="11"
                                                                     FontWeight="SemiBold"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,6,0"
                                                                     ToolTip="Square stamp brush mask" />
                                                        <RadioButton Content="● Circle"
                                                                     GroupName="CloneStampShape"
                                                                     IsChecked="{Binding IsCloneCircleShape}"
                                                                     FontSize="11"
                                                                     FontWeight="SemiBold"
                                                                     VerticalAlignment="Center"
                                                                     ToolTip="Circular stamp brush mask" />
                                                    </StackPanel>

                                                    <!-- Size / Radius Stepper -->
                                                    <Border Grid.Column="2"
                                                            Background="{DynamicResource CardBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,2">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Size:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                            <TextBlock Text="{Binding CloneStampRadius, StringFormat={}{0}px}" Width="36" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                                                            <Button Content="-" Command="{Binding CloneStampRadiusStepDownCommand}" Width="20" Height="22" Padding="0" Margin="2,0,0,0" ToolTip="Decrease stamp size" />
                                                            <Button Content="+" Command="{Binding CloneStampRadiusStepUpCommand}" Width="20" Height="22" Padding="0" Margin="2,0,0,0" ToolTip="Increase stamp size" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- Alignment Status Readout -->
                                                <TextBlock Text="{Binding CloneStampStatusText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Subpanel 3: Bevel & Clip Controls -->
                                        <Border Background="{DynamicResource ViewportBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,6"
                                                Margin="0,0,0,6">
                                            <StackPanel>
                                                <!-- Row 1: Alternating Tool Toggles (Bevel and Clip) + Transparent Color Swatch -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <ToggleButton Grid.Column="0" Content="Bevel"
                                                                  Style="{StaticResource AlternatingToolToggleButtonStyle}"
                                                                  IsChecked="{Binding IsBevelModeSelected}"
                                                                  Margin="0,0,6,0"
                                                                  ToolTip="Apply 3D raised gradient bevel around perimeter" />
                                                    <ToggleButton Grid.Column="1" Content="Clip"
                                                                  Style="{StaticResource AlternatingToolToggleButtonStyle}"
                                                                  IsChecked="{Binding IsClipModeSelected}"
                                                                  ToolTip="Clip/round corners to transparent by specified pixels" />

                                                    <!-- Transparent Key Color Swatch & Text -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Width="26" Height="26"
                                                                Background="{Binding TransparentColor, Converter={StaticResource ColorToBrush}}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                Command="{Binding CycleTransparentColorCommand}"
                                                                ToolTip="Click to cycle transparent key color (Cyan, Magenta, Lime, Black, White)" />
                                                        <TextBlock Text="Transparent Color" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Row 2: Action Buttons (Batch + Single) & Size Stepper -->
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Dynamic Batch Action Button (All Tiles: Clip All or Bevel All) -->
                                                        <Button Content="{Binding SharedToolBatchActionName}"
                                                                Command="{Binding ApplySharedToolAllCommand}"
                                                                IsEnabled="{Binding HasChitsLoaded}"
                                                                Width="86" Height="28"
                                                                Margin="0,0,6,0"
                                                                Style="{StaticResource AccentButtonStyle}"
                                                                ToolTip="{Binding SharedToolBatchActionToolTip}" />

                                                        <!-- Dynamic Action Button (Single Tile: Clip Current or Bevel Current) -->
                                                        <Button Content="{Binding SharedToolActionName}"
                                                                Command="{Binding ApplySharedToolCommand}"
                                                                Width="102" Height="28"
                                                                Margin="0,0,8,0"
                                                                Style="{StaticResource AccentButtonStyle}"
                                                                ToolTip="{Binding SharedToolActionToolTip}" />

                                                        <!-- Shared Value Display & Stepper Buttons -->
                                                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,2">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="Size:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                <TextBlock Text="{Binding SharedToolValue, StringFormat={}{0}px}" Width="36" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                                                                <Button Content="-" Command="{Binding SharedToolValueStepDownCommand}" Width="20" Height="22" Padding="0" Margin="2,0,0,0" ToolTip="Decrease size (1px)" />
                                                                <Button Content="+" Command="{Binding SharedToolValueStepUpCommand}" Width="20" Height="22" Padding="0" Margin="2,0,0,0" ToolTip="Increase size (1px)" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Row 6: Rotate Subpanel -->
                                        <Border Background="{DynamicResource ViewportBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,6"
                                                Margin="0,0,0,4">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="ROTATE"
                                                               FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </Grid>

                                                <!-- Single Horizontal Row: [↻ All] [↻ Current] -->
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="{Binding RotateBatchActionName, FallbackValue='↻ All'}"
                                                            Command="{Binding RotateAllTilesRightCommand}"
                                                            Height="26"
                                                            Padding="4,2"
                                                            FontSize="11"
                                                            ToolTip="{Binding RotateBatchActionToolTip, FallbackValue='Rotate all loaded tiles 90° clockwise'}" />
                                                    <Button Grid.Column="2"
                                                            Content="↻ Current"
                                                            Command="{Binding RotateCurrentTileRightCommand}"
                                                            Height="26"
                                                            Padding="4,2"
                                                            FontSize="11"
                                                            ToolTip="Rotate currently selected working tile 90° clockwise" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Subpanel 5: Smooth Background (Edge-Preserving Denoise) -->
                                        <Border Background="{DynamicResource ViewportBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,6"
                                                Margin="0,0,0,4">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="SMOOTH BACKGROUND"
                                                               FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <RadioButton Content="Light"
                                                                     GroupName="SmoothPreset"
                                                                     IsChecked="{Binding IsSmoothLight}"
                                                                     FontSize="10" FontWeight="SemiBold"
                                                                     Margin="0,0,4,0"
                                                                     ToolTip="Subtle grain-preserving: preserves natural counter grain and fine print (d=3, σ=18)" />
                                                        <RadioButton Content="Med"
                                                                     GroupName="SmoothPreset"
                                                                     IsChecked="{Binding IsSmoothMedium}"
                                                                     FontSize="10" FontWeight="SemiBold"
                                                                     Margin="0,0,4,0"
                                                                     ToolTip="Moderate smoothing: evens out paper texture while keeping text crisp (d=5, σ=30)" />
                                                        <RadioButton Content="Strong"
                                                                     GroupName="SmoothPreset"
                                                                     IsChecked="{Binding IsSmoothStrong}"
                                                                     FontSize="10" FontWeight="SemiBold"
                                                                     ToolTip="Controlled smoothing: suppresses heavy scan texture without washing out text (d=5, σ=45)" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Single Horizontal Row: [Smooth All / Smooth Selected] [Smooth Current] -->
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="{Binding SmoothBatchActionName, FallbackValue='Smooth All'}"
                                                            Command="{Binding SmoothAllTilesCommand}"
                                                            Height="26"
                                                            Padding="4,2"
                                                            FontSize="11"
                                                            ToolTip="{Binding SmoothBatchActionToolTip, FallbackValue='Smooth background for all loaded tiles'}" />
                                                    <Button Grid.Column="2"
                                                            Content="Smooth Current"
                                                            Command="{Binding SmoothCurrentTileCommand}"
                                                            Height="26"
                                                            Padding="4,2"
                                                            FontSize="11"
                                                            ToolTip="Smooth background on currently selected working tile" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Subpanel 6: Tile Cleanup Tools (Despeckle, Sharpen, Auto-Trim) -->
                                        <Border Background="{DynamicResource ViewportBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,6"
                                                Margin="0,0,0,4">
                                            <StackPanel>
                                                <TextBlock Text="TILE CLEANUP"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0,0,0,6" />

                                                <!-- Row 1: Despeckle -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="{Binding DespeckleBatchActionName, FallbackValue='Despeckle All'}"
                                                            Command="{Binding DespeckleAllTilesCommand}"
                                                            Height="26"
                                                            Padding="4,2"
                                                            FontSize="11"
                                                            ToolTip="{Binding DespeckleBatchActionToolTip, FallbackValue='Remove dust and scanner specks across tiles'}" />
                                                    <Button Grid.Column="2"
                                                            Content="Despeckle Current"
                                                            Command="{Binding DespeckleCurrentTileCommand}"
                                                            Height="26"
                                                            Padding="4,2"
                                                            FontSize="11"
                                                            ToolTip="Remove isolated dust specks on current tile without eroding text" />
                                                </Grid>

                                                <!-- Row 2: Gentle Sharpen -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="{Binding SharpenBatchActionName, FallbackValue='Sharpen All'}"
                                                            Command="{Binding SharpenAllTilesCommand}"
                                                            Height="26"
                                                            Padding="4,2"
                                                            FontSize="11"
                                                            ToolTip="{Binding SharpenBatchActionToolTip, FallbackValue='Restore edge crispness across tiles'}" />
                                                    <Button Grid.Column="2"
                                                            Content="Sharpen Current"
                                                            Command="{Binding SharpenCurrentTileCommand}"
                                                            Height="26"
                                                            Padding="4,2"
                                                            FontSize="11"
                                                            ToolTip="Gentle unsharp mask to restore edge crispness on current tile" />
                                                </Grid>

                                                <!-- Row 3: Auto-Trim -->
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="{Binding AutoTrimBatchActionName, FallbackValue='Trim All'}"
                                                            Command="{Binding AutoTrimAllTilesCommand}"
                                                            Height="26"
                                                            Padding="4,2"
                                                            FontSize="11"
                                                            ToolTip="{Binding AutoTrimBatchActionToolTip, FallbackValue='Auto-trim uniform or transparent margins across tiles'}" />
                                                    <Button Grid.Column="2"
                                                            Content="Trim Current"
                                                            Command="{Binding AutoTrimCurrentTileCommand}"
                                                            Height="26"
                                                            Padding="4,2"
                                                            FontSize="11"
                                                            ToolTip="Auto-trim uniform or transparent outer border on current tile" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- EDGE CLEANUP SECTION (Hidden via Visibility="Collapsed") -->
                                        <StackPanel Visibility="Collapsed">
                                            <!-- Divider between base tools and Edge Cleanup -->
                                            <Separator Margin="0,8,0,8" Background="{DynamicResource BorderBrush}" />

                                            <TextBlock Text="COLOR-MATCHED EDGE CLEANUP"
                                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,0,0,6" />

                                            <!-- Row 5: Background Color Swatch + Auto (Left) and Reset + Apply Buttons (Right) -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Swatch & Auto Button -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="26" Height="26"
                                                            Background="{Binding ChitEdgeCleanColor, Converter={StaticResource ColorToBrush}}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            ToolTip="Sampled or target background color for edge healing" />
                                                    <Button Content="Auto" Command="{Binding AutoSampleEdgeColorCommand}"
                                                            Height="26" Padding="6,0" Margin="4,0,0,0"
                                                            ToolTip="Auto-sample dominant background color from active tile" />
                                                </StackPanel>

                                                <!-- Reset & Apply Buttons Right -->
                                                <Button Grid.Column="2" Content="Reset" Command="{Binding ResetEdgeCleanCommand}" Width="60" Height="28" Margin="0,0,4,0"
                                                        ToolTip="Revert active tile to pre-cleanup state and reset edge clean depths to 0px" />
                                                <Button Grid.Column="3" Content="Apply" Command="{Binding ApplyEdgeCleanCommand}" Width="64" Height="28"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        ToolTip="Heal cut marks and edge artifacts with matching background color" />
                                            </Grid>

                                            <!-- Per-Side Depth Steppers: Top, Bottom, Left, Right -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="4" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Top Depth -->
                                                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource ViewportBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Top:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ChitEdgeCleanTopDepth, StringFormat={}{0}px}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Button Grid.Column="2" Content="-" Command="{Binding ChitEdgeCleanTopStepDownCommand}" Width="18" Height="20" Padding="0" Margin="2,0,0,0" ToolTip="Decrease top cleanup depth (1px)" />
                                                        <Button Grid.Column="3" Content="+" Command="{Binding ChitEdgeCleanTopStepUpCommand}" Width="18" Height="20" Padding="0" Margin="2,0,0,0" ToolTip="Increase top cleanup depth (1px)" />
                                                    </Grid>
                                                </Border>

                                                <!-- Bottom Depth -->
                                                <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource ViewportBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Btm:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ChitEdgeCleanBottomDepth, StringFormat={}{0}px}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Button Grid.Column="2" Content="-" Command="{Binding ChitEdgeCleanBottomStepDownCommand}" Width="18" Height="20" Padding="0" Margin="2,0,0,0" ToolTip="Decrease bottom cleanup depth (1px)" />
                                                        <Button Grid.Column="3" Content="+" Command="{Binding ChitEdgeCleanBottomStepUpCommand}" Width="18" Height="20" Padding="0" Margin="2,0,0,0" ToolTip="Increase bottom cleanup depth (1px)" />
                                                    </Grid>
                                                </Border>

                                                <!-- Left Depth -->
                                                <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource ViewportBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Left:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ChitEdgeCleanLeftDepth, StringFormat={}{0}px}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Button Grid.Column="2" Content="-" Command="{Binding ChitEdgeCleanLeftStepDownCommand}" Width="18" Height="20" Padding="0" Margin="2,0,0,0" ToolTip="Decrease left cleanup depth (1px)" />
                                                        <Button Grid.Column="3" Content="+" Command="{Binding ChitEdgeCleanLeftStepUpCommand}" Width="18" Height="20" Padding="0" Margin="2,0,0,0" ToolTip="Increase left cleanup depth (1px)" />
                                                    </Grid>
                                                </Border>

                                                <!-- Right Depth -->
                                                <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource ViewportBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Rgt:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ChitEdgeCleanRightDepth, StringFormat={}{0}px}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Button Grid.Column="2" Content="-" Command="{Binding ChitEdgeCleanRightStepDownCommand}" Width="18" Height="20" Padding="0" Margin="2,0,0,0" ToolTip="Decrease right cleanup depth (1px)" />
                                                        <Button Grid.Column="3" Content="+" Command="{Binding ChitEdgeCleanRightStepUpCommand}" Width="18" Height="20" Padding="0" Margin="2,0,0,0" ToolTip="Increase right cleanup depth (1px)" />
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <!-- Row 5: Mode Selector + Tolerance Steppers -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableEdgeCleanModes}"
                                                          SelectedItem="{Binding SelectedEdgeCleanMode}"
                                                          Width="116" VerticalAlignment="Center"
                                                          ToolTip="Targeted Replace: overwrite defect pixels; Smart Inpaint: seamless texture blend; Solid Flood: fill entire border" />

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <TextBlock Text="Tol:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                    <Button Content="-" Command="{Binding ChitEdgeCleanTolDecrementCommand}" Width="20" Height="22" Padding="0" ToolTip="Decrease tolerance (-5)" Margin="0,0,2,0" />
                                                    <TextBlock Text="{Binding ChitEdgeCleanTolerance}" Width="26" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" />
                                                    <Button Content="+" Command="{Binding ChitEdgeCleanTolIncrementCommand}" Width="20" Height="22" Padding="0" ToolTip="Increase tolerance (+5)" Margin="2,0,0,0" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 6: Checkbox Options -->
                                            <WrapPanel Margin="0,2,0,0">
                                                <CheckBox Content="Link sides"
                                                          IsChecked="{Binding LinkEdgeCleanSides}"
                                                          FontSize="11"
                                                          Margin="0,0,10,0"
                                                          ToolTip="When checked, adjusting any side adjusts all four sides together" />
                                                <CheckBox Content="Preserve corner clips"
                                                          IsChecked="{Binding PreserveTransparentCorners}"
                                                          FontSize="11"
                                                          Margin="0,0,10,0"
                                                          ToolTip="When checked, transparent corner pixels are never overwritten" />
                                                <CheckBox Content="Lock color"
                                                          IsChecked="{Binding LockEdgeCleanColor}"
                                                          FontSize="11"
                                                          ToolTip="Prevent automatic re-sampling when switching active tiles" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- COLUMN 1: CENTER WORKING CHIT CANVAS -->
                    <ScrollViewer Grid.Column="1"
                                  Background="{DynamicResource ViewportBackgroundBrush}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                            <!-- Populated Chit State -->
                            <StackPanel Visibility="{Binding HasChitsLoaded, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center">
                                <!-- Working Chit Area with 1% Step Zoom -->
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16"
                                        Margin="0,0,0,16"
                                        HorizontalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <!-- Header with Step & Save Controls -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="WORKING TILE"
                                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource ViewportBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Step:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                        <TextBlock Text="{Binding ChitBumpStepPx, StringFormat={}{0}px}" Width="36" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                                                        <Button Content="-" Command="{Binding BumpStepDownCommand}" Width="20" Height="22" Padding="0" Margin="2,0,0,0" ToolTip="Decrease bump step (-1px)" />
                                                        <Button Content="+" Command="{Binding BumpStepUpCommand}" Width="20" Height="22" Padding="0" Margin="2,0,0,0" ToolTip="Increase bump step (+1px)" />
                                                    </StackPanel>
                                                </Border>

                                                <Button Content="💾 Save Tile PNG..."
                                                        Command="{Binding ExportSelectedChitCommand}"
                                                        Visibility="Collapsed"
                                                        Padding="8,2" Margin="8,0,0,0"
                                                        FontSize="11"
                                                        ToolTip="Save this active tile to PNG file..." />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Surrounding Directional Bump Controls Layout -->
                                        <Grid HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- TOP: Bump Up ▲ -->
                                            <RepeatButton Grid.Row="0" Grid.Column="1"
                                                          Content="▲" Command="{Binding BumpChitUpCommand}"
                                                          IsEnabled="{Binding HasSelectedChit}"
                                                          Width="36" Height="22" Padding="0" Margin="0,0,0,6"
                                                          HorizontalAlignment="Center"
                                                          Delay="250" Interval="50"
                                                          ToolTip="Bump image up (fill bottom edge with transparent color)" />

                                            <!-- LEFT: Bump Left ◀ -->
                                            <RepeatButton Grid.Row="1" Grid.Column="0"
                                                          Content="◀" Command="{Binding BumpChitLeftCommand}"
                                                          IsEnabled="{Binding HasSelectedChit}"
                                                          Width="22" Height="36" Padding="0" Margin="0,0,6,0"
                                                          VerticalAlignment="Center"
                                                          Delay="250" Interval="50"
                                                          ToolTip="Bump image left (fill right edge with transparent color)" />

                                            <!-- CENTER: Working Chit Canvas -->
                                            <Border Grid.Row="1" Grid.Column="1"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Background="{StaticResource CheckerboardBrush}"
                                                    SnapsToDevicePixels="True"
                                                    HorizontalAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="(No Tile Selected)"
                                                               MinWidth="280" MinHeight="280"
                                                               TextAlignment="Center"
                                                               Padding="0,132,0,0"
                                                               Visibility="{Binding SelectedChit, Converter={StaticResource NullToVis}}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontSize="12" />
                                                    <Image x:Name="WorkingChitImage"
                                                           Source="{Binding SelectedChit.PreviewSource}"
                                                           Visibility="{Binding SelectedChit, Converter={StaticResource NotNullToVis}}"
                                                           Stretch="None"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           MouseDown="ChitPreview_MouseDown"
                                                           MouseMove="ChitPreview_MouseMove"
                                                           MouseUp="ChitPreview_MouseUp"
                                                           MouseLeave="ChitPreview_MouseLeave"
                                                           Cursor="Cross"
                                                           ToolTip="{Binding WorkingChitToolTip}"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor">
                                                        <Image.LayoutTransform>
                                                            <ScaleTransform ScaleX="{Binding ChitEditorZoomScale}" ScaleY="{Binding ChitEditorZoomScale}" />
                                                        </Image.LayoutTransform>
                                                    </Image>
                                                    <Canvas x:Name="WorkingChitOverlayCanvas"
                                                            IsHitTestVisible="False"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch">
                                                        <Canvas.LayoutTransform>
                                                            <ScaleTransform ScaleX="{Binding ChitEditorZoomScale}" ScaleY="{Binding ChitEditorZoomScale}" />
                                                        </Canvas.LayoutTransform>
                                                    </Canvas>
                                                </Grid>
                                            </Border>

                                            <!-- RIGHT: Bump Right ▶ -->
                                            <RepeatButton Grid.Row="1" Grid.Column="2"
                                                          Content="▶" Command="{Binding BumpChitRightCommand}"
                                                          IsEnabled="{Binding HasSelectedChit}"
                                                          Width="22" Height="36" Padding="0" Margin="6,0,0,0"
                                                          VerticalAlignment="Center"
                                                          Delay="250" Interval="50"
                                                          ToolTip="Bump image right (fill left edge with transparent color)" />

                                            <!-- BOTTOM: Bump Down ▼ -->
                                            <RepeatButton Grid.Row="2" Grid.Column="1"
                                                          Content="▼" Command="{Binding BumpChitDownCommand}"
                                                          IsEnabled="{Binding HasSelectedChit}"
                                                          Width="36" Height="22" Padding="0" Margin="0,6,0,0"
                                                          HorizontalAlignment="Center"
                                                          Delay="250" Interval="50"
                                                          ToolTip="Bump image down (fill top edge with transparent color)" />
                                        </Grid>

                                        <TextBlock Text="{Binding SelectedChit.DimensionsText}"
                                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Zoomed Pixel Inspection Area (Hidden, preserved for future reactivation) -->
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16"
                                        HorizontalAlignment="Center"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="ZOOMED PIXEL INSPECTION"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,0,0,8" />

                                        <!-- Magnification Controls -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                            <Button Content="-" Width="28" Height="24" Padding="0"
                                                    Command="{Binding ChitInspectionZoomOutCommand}"
                                                    ToolTip="Zoom out (25%)" Margin="2,0" />
                                            <Button Content="+" Width="28" Height="24" Padding="0"
                                                    Command="{Binding ChitInspectionZoomInCommand}"
                                                    ToolTip="Zoom in (25%)" Margin="2,0" />

                                            <Button Content="100%" Width="42" Height="24" Padding="0"
                                                    Command="{Binding SetChitInspectionZoomCommand}" CommandParameter="1.0"
                                                    ToolTip="Set zoom to 100%" Margin="2,0" />
                                            <Button Content="150%" Width="42" Height="24" Padding="0"
                                                    Command="{Binding SetChitInspectionZoomCommand}" CommandParameter="1.5"
                                                    ToolTip="Set zoom to 150%" Margin="2,0" />
                                            <Button Content="200%" Width="42" Height="24" Padding="0"
                                                    Command="{Binding SetChitInspectionZoomCommand}" CommandParameter="2.0"
                                                    ToolTip="Set zoom to 200%" Margin="2,0" />
                                            <Button Content="300%" Width="42" Height="24" Padding="0"
                                                    Command="{Binding SetChitInspectionZoomCommand}" CommandParameter="3.0"
                                                    ToolTip="Set zoom to 300%" Margin="2,0" />
                                            <Button Content="400%" Width="42" Height="24" Padding="0"
                                                    Command="{Binding SetChitInspectionZoomCommand}" CommandParameter="4.0"
                                                    ToolTip="Set zoom to 400%" Margin="2,0" />

                                            <Slider Minimum="1.0" Maximum="4.0"
                                                    Value="{Binding ChitInspectionZoomScale}"
                                                    SmallChange="0.25" LargeChange="0.5"
                                                    Width="90" VerticalAlignment="Center" Margin="8,0,4,0"
                                                    ToolTip="Adjust magnification (100% - 400%)" />

                                            <TextBlock Text="{Binding ChitInspectionZoomPercentageText}"
                                                       FontWeight="Bold" FontSize="11" Width="38"
                                                       VerticalAlignment="Center" TextAlignment="Right" />
                                        </StackPanel>

                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                Background="{StaticResource CheckerboardBrush}"
                                                SnapsToDevicePixels="True"
                                                HorizontalAlignment="Center">
                                            <Image Source="{Binding SelectedChit.PreviewSource}"
                                                   Stretch="None"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   MouseDown="ChitPreview_MouseDown"
                                                   Cursor="Cross"
                                                   ToolTip="Click to sample background color for Edge Cleanup"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor">
                                                <Image.LayoutTransform>
                                                    <ScaleTransform ScaleX="{Binding ChitInspectionZoomScale}" ScaleY="{Binding ChitInspectionZoomScale}" />
                                                </Image.LayoutTransform>
                                            </Image>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Splitter for Right Tile Strip -->
                    <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />

                    <!-- COLUMN 3: RIGHT TILE STRIP -->
                    <Border Grid.Column="3"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource ToolbarBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,6">
                                <StackPanel HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="TILE STRIP" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding LoadedChits.Count, StringFormat='{} ({0} pieces)'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Button Content="Select All" Command="{Binding SelectAllTilesCommand}"
                                                Height="22" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                                ToolTip="Select all tiles in strip for batch operations" />
                                        <Button Content="Deselect All" Command="{Binding DeselectAllTilesCommand}"
                                                Height="22" Padding="8,1" FontSize="11" Margin="4,0,0,0"
                                                ToolTip="Deselect all tiles in strip" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding LoadedChits}"
                                     SelectedItem="{Binding SelectedChit}"
                                     SelectionMode="Extended"
                                     VirtualizingPanel.IsVirtualizing="False"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="TileStripItem_PreviewMouseRightButtonDown" />
                                        <EventSetter Event="ContextMenuOpening" Handler="TileStripItem_ContextMenuOpening" />
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem Header="Select _All"
                                                              InputGestureText="Ctrl+A"
                                                              Command="{Binding PlacementTarget.Tag.SelectAllTilesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="_Deselect All"
                                                              InputGestureText="Esc"
                                                              Command="{Binding PlacementTarget.Tag.DeselectAllTilesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="_Invert Selection"
                                                              Command="{Binding PlacementTarget.Tag.InvertTileSelectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <Separator />
                                                    <MenuItem Header="_Reset to Original"
                                                              Command="{Binding PlacementTarget.Tag.ResetSelectedChitCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              IsEnabled="{Binding PlacementTarget.Tag.HasSelectedChit, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="_Export Tile(s)..."
                                                              InputGestureText="Ctrl+S"
                                                              Command="{Binding PlacementTarget.Tag.ExportSelectedChitCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              IsEnabled="{Binding PlacementTarget.Tag.HasSelectedChit, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <Separator />
                                                    <MenuItem Header="Rotate 90° _Clockwise"
                                                              InputGestureText="↻"
                                                              Command="{Binding PlacementTarget.Tag.RotateCurrentTileRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              IsEnabled="{Binding PlacementTarget.Tag.HasSelectedChit, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Rotate 90° Counter-Clock_wise"
                                                              InputGestureText="↺"
                                                              Command="{Binding PlacementTarget.Tag.RotateCurrentTileLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              IsEnabled="{Binding PlacementTarget.Tag.HasSelectedChit, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <Separator />
                                                    <MenuItem Header="_Copy Tile Image"
                                                              InputGestureText="Ctrl+C"
                                                              Command="{Binding PlacementTarget.Tag.CopyChitCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              IsEnabled="{Binding PlacementTarget.Tag.CanCopyTile, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="_Paste Image..."
                                                              InputGestureText="Ctrl+V"
                                                              Command="{Binding PlacementTarget.Tag.PasteImageToTileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Paste Image into _New Tile..."
                                                              Command="{Binding PlacementTarget.Tag.PasteImageToNewTileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <Separator />
                                                    <MenuItem Header="_Delete Current Tile..."
                                                              InputGestureText="Del"
                                                              Command="{Binding PlacementTarget.Tag.DeleteCurrentTileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              IsEnabled="{Binding PlacementTarget.Tag.CanDeleteCurrentTile, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Delete _Selected Tiles..."
                                                              Command="{Binding PlacementTarget.Tag.DeleteSelectedTilesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              IsEnabled="{Binding PlacementTarget.Tag.CanDeleteSelectedTiles, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="8,6"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F0F9FF" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#E0F2FE" />
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#0284C7" />
                                                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="3,0,0,1" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Column 0: Thumbnail on checkerboard -->
                                            <Border Grid.Column="0"
                                                    Width="52" Height="52"
                                                    Background="{StaticResource CheckerboardBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="2"
                                                    Margin="0,0,10,0">
                                                <Image Source="{Binding ThumbnailSource}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            </Border>

                                            <!-- Column 1: Metadata -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Index, StringFormat='{}#{0:D2}'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding CoordinateText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>

                                                <TextBlock Text="{Binding DimensionsText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />

                                                <TextBlock Text="● Edited" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B"
                                                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="3"
                Background="{DynamicResource StatusBarBackgroundBrush}"
                Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource StatusBarForegroundBrush}"
                           FontWeight="Normal"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Tab 0 Dimensions -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualToVis}, ConverterParameter=0}">
                        <TextBlock Text="{Binding PagePixelWidth, StringFormat='{}{0} × '}" Foreground="{DynamicResource StatusBarSubtleBrush}" />
                        <TextBlock Text="{Binding PagePixelHeight, StringFormat='{}{0} px'}" Foreground="{DynamicResource StatusBarSubtleBrush}" />
                        <TextBlock Text="|" Margin="8,0" Foreground="{DynamicResource StatusBarSubtleBrush}" />
                        <TextBlock Text="{Binding ZoomPercentageText, StringFormat='{}Zoom: {0}'}" Foreground="{DynamicResource StatusBarForegroundBrush}" FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- Tab 1 Dimensions -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualToVis}, ConverterParameter=1}">
                        <TextBlock Text="{Binding SlicerPixelWidth, StringFormat='{}{0} × '}" Foreground="{DynamicResource StatusBarSubtleBrush}" />
                        <TextBlock Text="{Binding SlicerPixelHeight, StringFormat='{}{0} px'}" Foreground="{DynamicResource StatusBarSubtleBrush}" />
                        <TextBlock Text="|" Margin="8,0" Foreground="{DynamicResource StatusBarSubtleBrush}" />
                        <TextBlock Text="{Binding SlicerZoomPercentageText, StringFormat='{}Zoom: {0}'}" Foreground="{DynamicResource StatusBarForegroundBrush}" FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- Tab 2 Dimensions -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualToVis}, ConverterParameter=2}">
                        <TextBlock Text="{Binding ChitStatusBarText}"
                                   Visibility="{Binding ChitStatusBarText, Converter={StaticResource NotNullToVis}}"
                                   Foreground="{DynamicResource StatusBarSubtleBrush}"
                                   Margin="0,0,8,0"
                                   MaxWidth="260"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ChitStatusBarText}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedChit.DimensionsText}" Foreground="{DynamicResource StatusBarSubtleBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="|" Margin="8,0" Foreground="{DynamicResource StatusBarSubtleBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LoadedChits.Count, StringFormat='{}{0} Tiles Loaded'}" Foreground="{DynamicResource StatusBarForegroundBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

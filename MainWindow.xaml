<Window x:Class="pdf_to_Tiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:pdf_to_Tiles.ViewModels"
        xmlns:conv="clr-namespace:pdf_to_Tiles.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="800" Width="1280"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NotNullToVis" Invert="False" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" Invert="True" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Foreground" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#3E3E42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Foreground" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#3E3E42" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Foreground" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#3E3E42" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="CaretBrush" Value="#F1F1F1" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="8,6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Open Button -->
                <Button Content="📂 Open PDF..."
                        Command="{Binding OpenPdfCommand}"
                        Padding="12,6"
                        ToolTip="Open a PDF rulebook or counter sheet (non-locking)" />

                <Rectangle Width="1" Height="24" Fill="#454545" Margin="8,0" />

                <!-- Page Navigation -->
                <Button Content="◀ Prev"
                        Command="{Binding PreviousPageCommand}"
                        ToolTip="Navigate to previous page" />

                <TextBlock Text="Page" Margin="6,0,2,0" />
                <TextBox Text="{Binding CurrentPageNumber, UpdateSourceTrigger=LostFocus}"
                         Width="45"
                         TextAlignment="Center"
                         FontWeight="Bold"
                         KeyDown="PageNumberTextBox_KeyDown"
                         ToolTip="Type page number and press Enter" />
                <TextBlock Text="of" Margin="4,0,2,0" />
                <TextBlock Text="{Binding TotalPages}" FontWeight="Bold" Margin="0,0,6,0" />

                <Button Content="Next ▶"
                        Command="{Binding NextPageCommand}"
                        ToolTip="Navigate to next page" />

                <Rectangle Width="1" Height="24" Fill="#454545" Margin="8,0" />

                <!-- View & Zoom Modes -->
                <Button Content="Fit to Page"
                        Command="{Binding FitToPageCommand}"
                        ToolTip="Scale page proportionally to fit inside the viewport" />

                <Button Content="Actual Size (100%)"
                        Command="{Binding ActualSizeCommand}"
                        ToolTip="Display page at 1:1 scale (100%)" />

                <Button Content="-"
                        Width="30"
                        Command="{Binding ZoomOutCommand}"
                        ToolTip="Zoom out" />

                <Button Content="+"
                        Width="30"
                        Command="{Binding ZoomInCommand}"
                        ToolTip="Zoom in" />

                <TextBlock Text="Zoom:" Margin="8,0,2,0" />
                <TextBlock Text="{Binding ZoomPercentageText}" FontWeight="Bold" Width="55" />

                <Rectangle Width="1" Height="24" Fill="#454545" Margin="8,0" />

                <!-- High-DPI Page Capture -->
                <TextBlock Text="DPI:" Margin="6,0,2,0" />
                <ComboBox ItemsSource="{Binding AvailableDpis}"
                          SelectedItem="{Binding SelectedDpi}"
                          Width="70"
                          ToolTip="Select capture DPI resolution" />

                <TextBlock Text="Tag:" Margin="6,0,2,0" />
                <ComboBox ItemsSource="{Binding AvailableSideTags}"
                          SelectedItem="{Binding SelectedSideTag}"
                          Width="80"
                          ToolTip="Label sheet side (Front, Back, Page)" />

                <Button Content="📸 Capture Page as PNG"
                        Command="{Binding CapturePageCommand}"
                        Background="#0E639C"
                        BorderBrush="#1177BB"
                        Foreground="#FFFFFF"
                        Padding="12,6"
                        Margin="6,0,2,0"
                        ToolTip="Save current page at high DPI directly to a lossless PNG file" />
            </WrapPanel>
        </Border>

        <!-- CENTER VIEWPORT -->
        <ScrollViewer x:Name="PageScrollViewer"
                      Grid.Row="1"
                      Background="#141414"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      SizeChanged="PageScrollViewer_SizeChanged">

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <!-- Drop shadow border around rendered page -->
                <Border Background="#FFFFFF"
                        BorderBrush="#000000"
                        BorderThickness="1"
                        CornerRadius="2"
                        SnapsToDevicePixels="True"
                        Visibility="{Binding CurrentPageImage, Converter={StaticResource NotNullToVis}}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.65" />
                    </Border.Effect>
                    <Image Source="{Binding CurrentPageImage}"
                           Stretch="None"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True">
                        <Image.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}" />
                        </Image.LayoutTransform>
                    </Image>
                </Border>

                <!-- Empty State Prompt -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding CurrentPageImage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="📄" FontSize="64" HorizontalAlignment="Center" Opacity="0.5" />
                    <TextBlock Text="No PDF Loaded"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#AAAAAA"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,4" />
                    <TextBlock Text="Click 'Open PDF...' to open a rulebook or counter sheet (non-locking)"
                               FontSize="13"
                               Foreground="#777777"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#007ACC" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="#FFFFFF"
                           FontWeight="Normal"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding PagePixelWidth, StringFormat='{}{0} × '}" Foreground="#E0E0E0" />
                    <TextBlock Text="{Binding PagePixelHeight, StringFormat='{}{0} px'}" Foreground="#E0E0E0" />
                    <TextBlock Text="|" Margin="8,0" Foreground="#A0CBE8" />
                    <TextBlock Text="{Binding ZoomPercentageText, StringFormat='{}Zoom: {0}'}" Foreground="#FFFFFF" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
